# Stage 1: Build
FROM node:22-alpine AS builder
WORKDIR /app

ARG VITE_BASE_URL
ARG VITE_SOCKET_UR
ARG VITE_APP_NAME
ARG VITE_EXT_RATING_PROVIDER
ARG VITE_SMALLEST_BID_INCREMENT_PERCENTAGE
ARG VITE_AUCTION_EXTENSION_MINUTES

ENV VITE_BASE_URL=$VITE_BASE_URL \
    VITE_SOCKET_URL=$VITE_SOCKET_URL \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_EXT_RATING_PROVIDER=$VITE_EXT_RATING_PROVIDER \
    VITE_SMALLEST_BID_INCREMENT_PERCENTAGE=$VITE_SMALLEST_BID_INCREMENT_PERCENTAGE \
    VITE_AUCTION_EXTENSION_MINUTES=$VITE_AUCTION_EXTENSION_MINUTES

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: Serve
FROM nginx:1.27-alpine AS production
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80 443
